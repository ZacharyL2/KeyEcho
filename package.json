{
  "name": "keyecho",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "bench:audio": "cargo test --release --manifest-path src-tauri/Cargo.toml reference_timing -- --ignored --nocapture",
    "test": "pnpm run test:rust && pnpm run web:test && pnpm run web:build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "updater": "tsx scripts/updater.ts",
    "release-notes": "tsx scripts/release-notes.ts",
    "postinstall": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm",
    "web:dev": "vite",
    "web:test": "vitest run --environment node",
    "web:build": "pnpm lint && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-deep-link": "2.6.3",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/dynamic": "2.1.5",
    "solid-js": "^1.9.18",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@actions/github": "^9.1.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx commitlint --edit $1"
  }
}
